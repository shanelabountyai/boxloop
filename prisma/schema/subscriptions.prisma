// BoxLoop's subscription tables (clone-owned). Money is Int cents (`...Cents`); never a float.

enum BillingInterval {
  month
  year
}

/// A plan in an org's catalog. Price terms (priceCents, interval, trialDays) are fixed at creation:
/// changing a price means a new plan and archiving the old one, so existing subscribers keep the
/// terms they signed up on (grandfathering, P0-1). Only the name is editable. D-001.
model Plan {
  id            String          @id @default(uuid()) @db.Uuid
  orgId         String          @db.Uuid
  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  priceCents    Int // CHECK >= 0 in the migration
  interval      BillingInterval
  trialDays     Int             @default(0) // CHECK 0..365 in the migration
  archivedAt    DateTime?       @db.Timestamptz(6) // set ⇒ hidden from signup; subscribers unchanged
  subscriptions Subscription[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)

  @@index([orgId])
}

/// Mirrors STATUSES in src/subscriptions/state.ts (a type check in transition.ts fails if they drift).
enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  pending_cancellation
  cancelled
}

/// A member's subscription to a plan. `status` changes only through transition() (P0-2), which
/// audits every move. Period dates are calendar days (P0-3, src/subscriptions/period.ts).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  orgId              String             @db.Uuid
  org                Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId             String             @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String             @db.Uuid
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: NoAction) // plans archive, never delete; NoAction (end-of-statement) lets an org delete cascade both
  status             SubscriptionStatus
  billingAnchor      DateTime           @db.Date // trial end, or signup day without a trial; billing dates are counted from it
  currentPeriodStart DateTime           @db.Date
  currentPeriodEnd   DateTime           @db.Date // exclusive; CHECK > start in the migration
  nextBillingDate    DateTime           @db.Date // start of the first unpaid period
  chargeAttempts     ChargeAttempt[]
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)

  @@index([orgId, status])
  @@index([userId])
  @@index([nextBillingDate])
}

enum ChargeOutcome {
  succeeded
  failed
}

/// One attempt to charge one billing period (P0-4). Inserted, never updated. Attempt 1 is the daily
/// billing run; dunning retries (P0-6) are 2, 3, ... The unique key is the idempotency key: a second
/// run of the same date cannot record a second charge for the same period.
model ChargeAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @db.Uuid
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime      @db.Date // the period being paid for: the subscription's nextBillingDate when charged
  attempt        Int
  amountCents    Int // CHECK >= 0 in the migration
  outcome        ChargeOutcome
  providerRef    String? // set on success
  failureReason  String? // set on failure
  attemptedOn    DateTime      @db.Date // the run's asOf (D-003)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([subscriptionId, periodStart, attempt])
}
