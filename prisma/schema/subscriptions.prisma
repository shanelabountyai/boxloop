// BoxLoop's subscription tables (clone-owned). Money is Int cents (`...Cents`); never a float.

enum BillingInterval {
  month
  year
}

/// A plan in an org's catalog. Price terms (priceCents, interval, trialDays) are fixed at creation:
/// changing a price means a new plan and archiving the old one, so existing subscribers keep the
/// terms they signed up on (grandfathering, P0-1). Only the name is editable. D-001.
model Plan {
  id            String          @id @default(uuid()) @db.Uuid
  orgId         String          @db.Uuid
  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  priceCents    Int // CHECK >= 0 in the migration
  interval      BillingInterval
  trialDays     Int             @default(0) // CHECK 0..365 in the migration
  archivedAt    DateTime?       @db.Timestamptz(6) // set ⇒ hidden from signup; subscribers unchanged
  subscriptions Subscription[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([id, orgId]) // target of Subscription's composite FK: a subscription's plan is in its own org
  @@index([orgId])
}

/// Mirrors STATUSES in src/subscriptions/state.ts (a type check in transition.ts fails if they drift).
enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  pending_cancellation
  cancelled
}

/// The mock provider's stand-in for a stored card (P0-6): `declines` makes every charge fail.
enum MockCard {
  approves
  declines
}

/// A member's subscription to a plan. `status` changes only through transition() (P0-2), which
/// audits every move. Period dates are calendar days (P0-3, src/subscriptions/period.ts).
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  orgId              String             @db.Uuid
  org                Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId             String             @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String             @db.Uuid
  plan               Plan               @relation(fields: [planId, orgId], references: [id, orgId], onDelete: NoAction) // plans archive, never delete; NoAction (end-of-statement) lets an org delete cascade both
  status             SubscriptionStatus
  billingAnchor      DateTime           @db.Date // trial end, or signup day without a trial; billing dates are counted from it
  currentPeriodStart DateTime           @db.Date
  currentPeriodEnd   DateTime           @db.Date // exclusive; CHECK > start in the migration
  nextBillingDate    DateTime           @db.Date // start of the first unpaid period
  card               MockCard           @default(approves) // written only by setCard() in transition.ts
  creditCents        Int                @default(0) // downgrade credit owed to the next invoice (P0-5); CHECK >= 0 in the migration
  pausedUntil        DateTime?          @db.Date // the day a pause ends (P0-7); CHECK set exactly when paused, in the migration
  couponOffBps       Int                @default(0) // coupon percent off (P1-2), for the next couponPeriodsLeft invoices; CHECK 0..10000
  couponPeriodsLeft  Int                @default(0) // paid periods the coupon still discounts; CHECK >= 0
  paidOffBps         Int                @default(0) // the discount the current paid period was charged at, for proration; CHECK 0..10000
  chargeAttempts     ChargeAttempt[]
  planChanges        PlanChange[]
  trialReminder      TrialReminder?
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)

  @@index([orgId, status])
  @@index([userId])
  @@index([nextBillingDate])
}

enum ChargeOutcome {
  succeeded
  failed
}

/// One attempt to charge one billing period (P0-4). Inserted, never updated. Attempt 1 is the daily
/// billing run; dunning retries (P0-6) are 2, 3, ... The unique key is the idempotency key: a second
/// run of the same date cannot record a second charge for the same period.
model ChargeAttempt {
  id                 String        @id @default(uuid()) @db.Uuid
  subscriptionId     String        @db.Uuid
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart        DateTime      @db.Date // the period being paid for: the subscription's nextBillingDate when charged
  attempt            Int
  amountCents        Int // CHECK >= 0 in the migration; the plan price less discountCents, then creditAppliedCents
  creditAppliedCents Int           @default(0) // credit this invoice used up (P0-5); CHECK >= 0 in the migration
  discountCents      Int           @default(0) // coupon discount, taken before credit (P1-2); CHECK >= 0 in the migration
  outcome            ChargeOutcome
  providerRef        String? // set on success; "credit" when credit covered the whole amount and nothing was charged
  failureReason      String? // set on failure
  attemptedOn        DateTime      @db.Date // the run's asOf (D-003)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([subscriptionId, periodStart, attempt])
}

/// A mid-period plan change (P0-5). Inserted, never updated; the line items of its proration. The credit
/// line (<= 0) is the unused part of the old plan, the charge line (>= 0) the new plan for the same days.
/// A positive net is charged at once; a negative net becomes Subscription.creditCents for the next invoice.
/// `seq` numbers a subscription's changes and is the charge's idempotency key, as `attempt` is for charges.
model PlanChange {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  seq            Int
  fromPlanId     String       @db.Uuid
  toPlanId       String       @db.Uuid
  effectiveOn    DateTime     @db.Date
  remainingDays  Int
  periodDays     Int
  creditCents    Int // CHECK <= 0 in the migration
  chargeCents    Int // CHECK >= 0 in the migration
  netCents       Int // creditCents + chargeCents, CHECKed in the migration
  discountBps    Int          @default(0) // the paid period's coupon discount, applied to both prices before prorating (P1-2)
  providerRef    String? // set when a positive net was charged
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([subscriptionId, seq])
}

/// The trial-ending reminder (P1-3), at most one per subscription: a subscription has one trial. The billing
/// run inserts it with the outbox row in one transaction, so a rerun, or a racing run, cannot queue a second.
model TrialReminder {
  subscriptionId String       @id @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  trialEndsOn    DateTime     @db.Date // the conversion date the reminder named
  queuedOn       DateTime     @db.Date // the billing run's day
}
